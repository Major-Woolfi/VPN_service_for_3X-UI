{
  "name": "vpn-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2010",
    "test": "tsx --test src/lib/i18n-server.test.ts src/components/SafeHTML.test.tsx",
    "build": "npx tsx scripts/generate-i18n.ts && next build",
    "start": "next start -p 2010",
    "lint": "eslint",
    "generate-i18n": "npx tsx scripts/generate-i18n.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"next.config.ts\" \"eslint.config.mjs\" \"postcss.config.mjs\" \"package.json\" \"public/translations/ru.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"next.config.ts\" \"eslint.config.mjs\" \"postcss.config.mjs\" \"package.json\" \"public/translations/ru.json\""
  },
  "dependencies": {
    "next": "^15.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.2.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
