# --- VPN PROJECT NAMES ---
VPN_NAME=YourVPN

# --- DEFAULT LANGUAGE ---
DEFAULT_LANGUAGE=ru

# --- TELEGRAM BOT ---
# Все секреты ниже - примеры: замените их до запуска на собственные уникальные строки.
BOT_TOKEN=CHANGE_ME_BOT_TOKEN_0123456789abcdef
BOT_USERNAME=your_bot_username
ADMIN_USER_IDS=100000001,100000002
ADMIN_AUTO_SUBSCRIBE_DAYS=3650
ADMIN_SUB_EMAIL=
ADMIN_SUB_ID=Admin
PASSWORD_MIN_LENGTH=10

# --- FASTAPI SERVER ---
BOT_API_ENABLED=true
BOT_API_KEY=CHANGE_ME_BOT_API_KEY_0123456789abcdef
BOT_ADMIN_KEY=CHANGE_ME_BOT_ADMIN_KEY_0123456789abcdef
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=2005
FASTAPI_DOCS=false
FASTAPI_CORS_ENABLED=true
FASTAPI_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
# 0 = игнорировать X-Forwarded-For. Указывать только для доверенного proxy:
# 1 = nginx, 2 = nginx + CDN.
TRUST_PROXY_COUNT=0
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_0123456789abcdef
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_0123456789abcdef
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_AGE=21600
SESSION_COOKIE_SECURE=true
# same-origin /api/bot: кросс-сайт не нужен. none только при реальном кросс-сайт-frontend.
SESSION_COOKIE_SAMESITE=lax

# --- PAYMENT / FINANCE ---
PAYMENT_CARD_NUMBER=...
YOOMONEY_WALLET=...
PAYMENT_PROCESSING_TIMEOUT_SEC=900
PAYMENT_CLEANUP_INTERVAL_SEC=259200

# --- 3X-UI PANEL ---
PANEL_BASE=https://your-panel-url/secret/
SUB_PANEL_BASE=https://your-panel-url/sub/
JSON_SUB_PANEL_BASE=https://your-panel-url/json/
PANEL_LOGIN=...
PANEL_PASSWORD=...
PANEL_TOKEN=...
PANEL_HTTP_TIMEOUT_SEC=15
VERIFY_SSL=true

# --- DATA STORAGE ---
# Все пути должны находиться внутри каталога bot/
LANGS_DIR=./langs
DATA_DIR=./data
DATA_FILE=./data/users.db
DATA_AWAIT=./data/await_payments.json
# Каталог тарифов режима old
TARIFFS_PATH=./data/tarifs.json
# Каталог тарифов режима new
TARIFFS_NEW_PATH=./data/tarifs_new.json
# Общий список локаций для обоих режимов
SERVERS_PATH=./data/servers.json
# old | new
TARIFF_MODE=old
PARTNER_OPS_FILE=./data/partner_operations.json
SQLITE_TIMEOUT_SEC=30

# --- SSH ---
SSH_HOST=...
SSH_USER=root
SSH_KEY_PATH=./ssh/your-key.id_ed25519
SSH_PASSWORD=...

# --- PUBLIC LINKS ---
SITE_URL=https://your-domain.com
SUPPORT_URL=https://t.me/your_support
QNA_URL=https://your-domain.com/qa
PRIVACY_POLICY_URL=https://your-domain.com/privacy
PUBLIC_OFFER_URL=https://your-domain.com/offer
TERMS_OF_SERVICE_URL=https://your-domain.com/tos
TIKTOK_URL=
YOUTUBE_URL=
TELEGRAM_URL=https://t.me/your_channel
CLIENT_APP_URL=https://github.com/INCY-DEV/incy-platforms
SETUP_GUIDE_URL=https://t.me/off_PhantomVPN/436

# --- EXPIRY ALERT SETTINGS ---
EXPIRY_ALERT_DAYS=7
SUBSCRIPTION_CHECK_INTERVAL_SEC=3600

# --- REFERRALS AND BONUSES ---
REF_BONUS_DAYS=7

# --- TRUST SCORE SETTINGS ---
TRUST_SCORE_ENABLED=true
TRUST_SCORE_MIN=0
TRUST_SCORE_MAX=100
TRUST_SCORE_EARN_PERCENT=5
TRUST_SCORE_DISCOUNT_PERCENT_PER_POINT=0.5
TRUST_SCORE_PENALTY_TRAFFIC_EXHAUSTED=5
TRUST_SCORE_PENALTY_PAYMENT_REJECTED=10

# --- CUSTOM TARIFF SETTINGS ---
# Значения ниже - пример конфигурации, а не дефолты Config (base 20, location 2).
CUSTOM_TARIFF_ENABLED=true
CUSTOM_TARIFF_MIN_IP=1
CUSTOM_TARIFF_MAX_IP=30
CUSTOM_TARIFF_MIN_GB=1
CUSTOM_TARIFF_MAX_GB=36500
CUSTOM_TARIFF_MIN_DAYS=1
CUSTOM_TARIFF_MAX_DAYS=365
CUSTOM_TARIFF_BASE_PRICE=10
CUSTOM_TARIFF_GB_COEF=0.2
CUSTOM_TARIFF_IP_DAY_COEF=1.5
CUSTOM_TARIFF_LOCATION_DAY_PRICE=0.5

# --- PARTNERSHIP SETTINGS ---
PARTNER_ENABLED=true
PARTNER_NEW_AUTO_MODE=false
PARTNER_MIN_FOLLOWERS=1000
PARTNER_MIN_AVG_REACH=5000
PARTNER_REQUIRED_SOCIALS=Telegram, YouTube, TikTok
PARTNER_TERMS_URL=https://your-domain.com/partner
PARTNER_MIN_PERIOD_MONTHS=1
PARTNER_MAX_PERIOD_MONTHS=12
PARTNER_BONUS_DAYS_MIN=3
PARTNER_BONUS_DAYS_MAX=10
PARTNER_TRUST_POINTS_MIN=10
PARTNER_TRUST_POINTS_MAX=40
PARTNER_COMMISSION_PERCENT=10
PARTNER_EXPIRY_GRACE_DAYS=7
# Новая авто-партнёрка через ТГК: тип бонуса (ровно один из days|discount) и его значение
PARTNER_BONUS_TYPE=days
PARTNER_BONUS_VALUE=5
# Интервал проверки прав бота во всех ТГК партнёров (сек), по умолчанию 3 часа
PARTNER_CHANNEL_CHECK_INTERVAL_SEC=10800

# --- CO-OWNERS ---
# Рандомизированные со-владельцы. Формат: Telegram ID:юзернейм через запятую.
CO_OWNERS=111:alex,222:mike
# Процент со-владельца от оплат приведённых пользователей.
CO_OWNERS_COMMISSION_PERCENT=10

# --- RATE LIMITING ---
RATE_LIMIT_COOLDOWN=0.3
API_RATE_LIMIT=120
API_RATE_WINDOW=60
API_RATE_LIMIT_SENSITIVE_MAX=20
API_RATE_LIMIT_SENSITIVE_WINDOW=60

# --- TRAFFIC ABUSE TRACKING ---
TRAFFIC_ABUSE_CHECK_INTERVAL_SEC=86400
TRAFFIC_ABUSE_DAILY_LIMIT_GB=50.0
TRAFFIC_ABUSE_TOTAL_LIMIT_GB=1000.0

# --- TECH WORK MODE ---
TECH_WORK_BACKUP_INBOUND=🇳🇱 🚧 TECH WORK 🚧

# --- BROADCAST / MAILING ---
BROADCAST_DELETE_DEAD_USERS=false
